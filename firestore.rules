rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profillar: kirgan har kim o'qiy oladi, faqat egasi yoza oladi
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role in ['teacher', 'student']
        && request.resource.data.nick is string
        && request.resource.data.size() < 20;
      allow delete: if false;
    }
    // Nikneymlar band qilish uchun: nicks/{nick} -> { uid }
    match /nicks/{nick} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
